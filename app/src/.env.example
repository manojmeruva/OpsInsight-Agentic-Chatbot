# ─────────────────────────────────────────────────────────────────────────────
# OpsInsight — environment configuration
# Copy to app/src/.env and fill in values:   cp .env.example .env
# Defaults below run fully locally: Gemini + SQLite (no StarRocks/Mongo/ES/Vault)
# ─────────────────────────────────────────────────────────────────────────────

# ── LLM (Google Gemini) ──────────────────────────────────────────────────────
PROVIDER=google
# Get a key at https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your-gemini-api-key
# Orchestrator (tool routing / chat) and code-gen (text-to-SQL) models
ORCHESTRATOR_MODEL=gemini-2.5-flash
CODEGEN_MODEL=gemini-2.5-flash
TEMPERATURE=0.1

# ── Data warehouse the generated SQL runs against ────────────────────────────
# sqlite    → local app/src/finance.db (read-only), SQLite dialect
# starrocks → production StarRocks/MySQL (STARROCKS_* below), MySQL dialect
DATA_DB_ENGINE=sqlite
# SQLITE_DATA_DB_PATH=./finance.db

# STARROCKS_IP=127.0.0.1
# STARROCKS_PORT=9030
# STARROCKS_USER=root
# STARROCKS_PASSWORD=
# STARROCKS_DB=finance
# STARROCKS_POOL_SIZE=5
# STARROCKS_POOL_MAX_OVERFLOW=10
# STARROCKS_POOL_RECYCLE=1800

# ── Session store ────────────────────────────────────────────────────────────
# sqlite → local app/src/sessions.db (created automatically)
# mongo  → MongoDB (MONGO_URI + DB_NAME below)
DB_TYPE=sqlite
# SQLITE_SESSION_DB_PATH=./sessions.db

# MONGO_URI=mongodb://localhost:27017
# DB_NAME=opsinsight

# ── Elasticsearch archival (optional) ────────────────────────────────────────
ES_ENABLED=false
# ES_HOST=localhost
# ES_PORT=9200
# ES_SCHEME=http
# ES_USERNAME=
# ES_PASSWORD=
# ES_VERIFY_CERTS=true

# ── HashiCorp Vault (optional) ───────────────────────────────────────────────
# When VAULT_ADDR is set, GOOGLE_API_KEY is fetched from Vault instead of above.
# VAULT_ADDR=http://127.0.0.1:8200
# VAULT_USERNAME=
# VAULT_PASSWORD=
# VAULT_SECRET_PATH=dev_env

# ── Misc ─────────────────────────────────────────────────────────────────────
SESSION_TIMEOUT_SECONDS=30
# HTTP_PROXY=
